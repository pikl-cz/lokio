{
  "name": "@lokio/browser",
  "version": "0.1.0",
  "description": "Lokio adapter for browsers, backed by the File System Access API and OPFS.",
  "keywords": [
    "lokio",
    "local-first",
    "offline-first",
    "filesystem",
    "file-system-access",
    "workspace",
    "typescript"
  ],
  "homepage": "https://github.com/pikl-cz/lokio/tree/main/packages/browser#readme",
  "bugs": {
    "url": "https://github.com/pikl-cz/lokio/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pikl-cz/lokio.git",
    "directory": "packages/browser"
  },
  "license": "MIT",
  "author": "Jan Pikl",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --out-dir dist --clean",
    "dev": "tsup src/index.ts --format esm --dts --out-dir dist --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rimraf dist",
    "prepack": "node ../../scripts/copy-license.mjs"
  },
  "dependencies": {
    "@lokio/core": "workspace:^",
    "@lokio/types": "workspace:^"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
