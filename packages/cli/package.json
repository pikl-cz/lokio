{
  "name": "@lokio/cli",
  "version": "0.1.0",
  "description": "Developer tooling for Lokio: lokio init | doctor | info | build.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "lokio": "./dist/index.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format esm --out-dir dist --clean",
    "dev": "tsup src/index.ts --format esm --out-dir dist --watch",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@lokio/core": "*"
  }
}
